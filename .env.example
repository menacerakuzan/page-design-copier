# Frontend → PostgREST (the self-hosted API origin) + anon JWT
VITE_API_URL=
VITE_API_ANON_KEY=
VITE_OPENWEATHER_KEY=
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# Seed scripts (scripts/seed-*.mjs) connect directly to Postgres
DATABASE_URL=postgresql://authenticator:changeme123@localhost:5432/tourism

# ── Туристичний ІІ-асистент (окремий Node-процес, server-only — БЕЗ VITE_ префікса) ──
# Ключ OpenAI живе лише на сервері й ніколи не потрапляє у фронтенд-бандл.
OPENAI_API_KEY=
# Модель легко міняється однією змінною (напр. gpt-4o, gpt-4.1-mini):
ASSISTANT_MODEL=gpt-4o-mini
# Тюнінг (необовʼязково):
# ASSISTANT_TEMPERATURE=0.6
# ASSISTANT_MAX_TOKENS=1200
# ASSISTANT_MAX_HISTORY=20
ASSISTANT_PORT=8790
# PostgREST для читання каталогу (той самий anon-ключ, що й VITE_API_ANON_KEY):
POSTGREST_URL=http://127.0.0.1:3100
POSTGREST_ANON_KEY=
